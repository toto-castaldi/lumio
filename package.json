{
  "name": "lumio",
  "private": true,
  "version": "1.7",
  "pnpm": {
    "overrides": {
      "react": "19.1.0"
    }
  },
  "scripts": {
    "build:packages": "pnpm --filter @lumio/shared build && pnpm --filter @lumio/core build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:functions": "supabase functions serve --env-file supabase/.env.local --no-verify-jwt",
    "extract-version": "node scripts/extract-version.cjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
